# Браузерный SDK-клиент. Пусто => same-origin ("/api/..."), кука ходит корректно.
# В проде оставляй пустым или указывай публичный origin сайта (https://fl.2bd.net).
NEXT_PUBLIC_API_URL=

# Куда сервер (rewrite в next.config + серверные компоненты) форвардит "/api/*".
# Локально — бэкенд на 8000, в докере — http://floppa-backend:8000.
INTERNAL_API_URL=http://localhost:8000
