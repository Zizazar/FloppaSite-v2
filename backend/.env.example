# Переменные окружения для backend

# Основные параметры
DEBUG=True

# Сервер
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# База данных
# SQLite (разработка)
# DATABASE_URL=sqlite+aiosqlite:///./test.db

# PostgreSQL
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/floppasitedb

# MySQL
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/floppasitedb

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production

# CORS (дополнительные источники)
# ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

UPLOAD_DIR=./uploads